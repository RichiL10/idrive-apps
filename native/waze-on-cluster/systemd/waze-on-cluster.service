[Unit]
Description=waze-on-cluster: the captured CarPlay map, decoded for the cluster renderer
RequiresMountsFor=/var/opt
Requires=waze-on-cluster.socket
# The shared cluster renderer draws the map; its socket starts it at the first
# connection.
Wants=cluster-render.socket
After=local-fs.target waze-on-cluster.socket cluster-render.socket
# Restart=on-failure below restarts the render after a failure exit (poll()
# error, the GPU decoder beyond recovery, RAMSES or DCSM not up at boot).
# With RestartSec=5 systemd's default start limit (5 starts in 10 s) is never
# reached, so a fault that never clears would restart it forever. 30 starts
# in 10 minutes still covers a slow boot (about 150 s of failed starts) and
# then leaves the unit failed instead of looping; the next head-unit start
# or `systemctl reset-failed` clears it. Kiro test change, not yet run on the
# car. The keys need systemd 230 or later; the unit runs systemd 237 (the
# mgu-deploy tool this installs through checks for 237 and works around its
# start-limit behaviour), so they apply there.
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
# hmi_5000 is in the video group, so this process can open
# /dev/dri/renderD128 for MSDK/VAAPI decode (VERIFIED: /etc/group).
User=hmi_5000
Group=hmi_5000
# The AVB bridge uses the UFIPC shared-memory channel, whose files are
# sin_ufipc:mgu_ufipc mode 0660, which hmi_5000 is not in by default (VERIFIED
# on the car: root could join media_transport.avb_streaming.15, hmi_5000
# could not). tm_oap_app opens the cluster renderer's socket.
SupplementaryGroups=mgu_ufipc tm_oap_app
# Lets the receive threads, which only copy each packet of the phone's
# stream into the decode queue, run at nice -5, the HMI's own level, so a
# busy unit does not delay them; the decode thread stays at nice 0. The
# stock media units grant LimitNICE or LimitRTPRIO the same way.
LimitNICE=-5
RuntimeDirectory=waze-on-cluster
# World-traversable so the carplay uid can reach the FIFO (file group-restricted)
# and the diagnostics uid can read status.json; the files set their own modes.
RuntimeDirectoryMode=0755
# The log file's directory (log_file), on /var/opt so it outlives reboots,
# made as root ("+"); a failure ("-") only leaves the service without the
# file.
ExecStartPre=-+/bin/sh -c 'mkdir -p /var/opt/waze-on-cluster/log && chown hmi_5000:hmi_5000 /var/opt/waze-on-cluster/log'
ExecStart=/var/opt/waze-on-cluster/current/waze-on-cluster -c /var/opt/waze-on-cluster/current/waze-on-cluster.conf
Restart=on-failure
# At boot RAMSES or DCSM may not be up yet; 5 s keeps the retries clear of
# systemd's start limit (5 starts in 10 s), which would also stop the socket.
RestartSec=5

[Install]
# Runs from boot, so it is listening when the phone's stream starts (its only
# keyframes are at that start) and the map comes up with CarPlay.
WantedBy=multi-user.target
